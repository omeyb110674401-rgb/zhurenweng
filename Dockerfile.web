# web 服务（Next.js 生产构建）。仅生产部署使用，开发机不可运行 Docker（ADR-0001）。
FROM node:24-slim

WORKDIR /app

COPY package.json package-lock.json ./
# better-sqlite3 自带预编译二进制，slim 镜像无 Python/工具链，跳过 install 脚本（ADR-0001 同源处理）
RUN npm ci --ignore-scripts

COPY . .
RUN npm run build

ENV NODE_ENV=production
EXPOSE 3000

CMD ["npm", "run", "start"]
