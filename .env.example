# 生产环境变量模板：`cp .env.example .env` 后填写真实值（.env 已被 gitignore，勿提交）
# 本文件与 docker-compose.yml 的 ${VAR} 引用一一对应；详尽说明见 README 环境变量表。

# ── 数据库（compose 内网）────────────────────────────────────────
POSTGRES_PASSWORD=change-me-strong-password

# ── 域名与 TLS（Caddy 自动签发 Let's Encrypt 证书）──────────────
# DOMAIN 的 DNS A 记录须已指向本机公网 IP，且安全组放行 80 / 443
DOMAIN=your-domain.example

# ── 站点对外地址（必须 https，且与 DOMAIN 一致）──────────────────
SITE_URL=https://your-domain.example
APP_BASE_URL=https://your-domain.example

# ── 大模型（PRD：已备案的国产模型；服务商可切换）─────────────────
# LLM_PROVIDER：glm（默认，智谱预设）| openai（任何 OpenAI 兼容端点）| stub（本地测试）
LLM_PROVIDER=glm
# 预设服务商（glm）——只有 Key 必填，基址与模型有默认值
GLM_API_KEY=
GLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flash
# 通用端点（LLM_PROVIDER=openai 时三项都必填；换模型只改这里，不动代码）
LLM_API_KEY=
LLM_API_BASE=
LLM_MODEL=
# 单次请求超时（毫秒，缺省 60000）与额外请求头（JSON 对象，缺省不加）
LLM_TIMEOUT_MS=
LLM_EXTRA_HEADERS=

# ── 邮件（SMTP；用于订阅确认/提醒与失败告警）────────────────────
# 生产 compose 把 MAILER_PROVIDER 固定为 smtp；本地/测试走 stub（ADR-0001 第 5 条）。
# 国内云主机一律封着 25 端口出站，只能用 465（隐式 TLS 直连）。
# QQ / 163 这类个人邮箱要填后台生成的「授权码」，不是网页登录密码。
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# 只认 1（隐式 TLS）/ 0（STARTTLS）；留空按端口推断（465 → 直连）。填 true 会当场报错
SMTP_SECURE=
MAIL_FROM=

# ── 检索 ────────────────────────────────────────────────────────
MEILI_MASTER_KEY=change-me-strong-master-key

# ── 管理后台与告警（ADMIN_TOKEN 建议 32 位随机串）────────────────
ADMIN_TOKEN=change-me-random-token
ALERT_EMAIL=

# ── 页脚 ICP 备案号（如 京ICP备2026000000号-1；未填则显示占位文案）──
ICP_NUMBER=

# ── 抓取调度间隔（毫秒；默认每日一轮，改小前请确认对源站足够礼貌）──
WORKER_INTERVAL_MS=86400000
# 收到停止信号后等待在途轮次收尾的上限。附件抽取让单轮变长（单个文件最坏
# 「探测 + 整档 + 解析」几十秒），但每个文件处理完整就立刻写终态，60s 足够。
WORKER_STOP_WAIT_MS=60000

# ── 抓取超时（issue #58）─────────────────────────────────────────
# 一次 HTTP 请求的总预算（毫秒）：AbortSignal.timeout 同时掐表头与响应体，所以「连上了
# 但对端不再吐字节」也会被按时掐断。超时错误会带上这个毫秒数与 URL。
# 个别站点常年偏慢，请改**适配器**里的按源声明（src/sources/adapters/npc.ts 的
# fetch.timeoutMs），不要抬这个全局值 —— 它是所有源共用的上限，为一家慢站等到 30s
# 会让每轮抓取在其余八家上也一起变慢。填非法值（非数字 / <1000ms）在进程启动时就报错。
CRAWL_TIMEOUT_MS=15000

# ── 新公示通知（issue #60 第 3 刀）───────────────────────────────
# 只通知"首次收录时间"在回看窗口内的条目（`notices.first_seen_at`，建行时写入、更新不覆盖）。
# 窗口之外的一律不发；存量条目（本次上线之前就入库的）first_seen_at 为 NULL，永不通知 ——
# 这样刚确认订阅的老邮箱不会收到库里全部历史公示。每封汇总邮件至多 20 条，
# 没列进的条目不写去重标记，下一封还会带来。一人一封（不是一条一封）。
NOTIFY_LOOKBACK_DAYS=7

# ── 限流（次/小时，按客户端 IP 的固定窗口；留空用缺省值，填 0 = 不限流）──
# 订阅端点会真的发信：不限流时任何人都能对任意邮箱反复触发确认邮件（发信域声誉）
SUBSCRIBE_RATE_LIMIT_PER_HOUR=
# 后台登录：共享密钥可被无限次在线爆破，缺省 30
ADMIN_LOGIN_RATE_LIMIT_PER_HOUR=

# ── 附件条文读取（issue #57）─────────────────────────────────────
# off = 完全不跑；shadow = 下载并解析、写库出审计数，但摘要**不读**（页面不变）；
# on = 摘要把附件文本当第二路输入，并产出带出处的「草案条文要点」。
# 缺省 on 是因为这一档**真的有效果**（第 5 步已接线，e2e 断言两档产出的摘要不同）；
# 档位写错（笔误等非法值）会当场报错退出，不会静默当成 off。
# 代码缺省、本文件的值、compose 的 :- 回退值三处必须同值（tests/unit/deploy-env-contract 守）。
ATTACHMENT_TEXT=on
# 逗号分隔的源 ID 黑名单（缺省为空 = 谁都不排除）。曾经写着 npc，理由是"它的详情是
# JSON 接口、根本不产附件" —— issue #86 第十八节把那个前提翻掉了：npc 在开关打开时会
# 声明草案 PDF（见下面那个开关）。留着它会造出最难查的一种假象：清单声明了、开关也开了，
# 抽取任务却整轮跳过它，日志上只有"处理 0 条"。
ATTACHMENT_EXCLUDE_SOURCES=
# 全国人大网的法律草案电子文档（PDF，`/flcaw/flca/<lid>/attachment.pdf`）要不要抓。
# off（缺省）/ on。为什么缺省关：打开它意味着**开始按几十 MB 一档拉文件**（实测五条草案里
# 四份 0.4–1.3 MB、一份 41 MB），所以"部署代码"与"开始拉文件"是两次独立的决定。
# 开之前必须确认按源预算生效（`src/sources/adapters/npc.ts` 的 ATTACHMENT_BUDGET：
# 64 MB / 120 秒）—— 全局是 4 MB / 15 秒，两处都会把那份 41 MB 的草案挡在门外。
# 三处缺省（代码 / 本文件 / compose 回退值）必须同值（tests/unit/deploy-env-contract 守）。
NPC_DRAFT_ATTACHMENTS=off
# 一轮的礼貌预算：先到先停，剩余留到下一轮（行会一直停在 pending）。
# 单轮最多下载多少个附件文件
ATTACHMENT_MAX_FILES_PER_ROUND=120
# 单轮墙钟上限（毫秒）
ATTACHMENT_ROUND_BUDGET_MS=1200000
# 同一主机两次附件请求的最小间隔（页面抓取是 400ms，文件更大所以更客气）
ATTACHMENT_HOST_INTERVAL_MS=3000
# 一轮内同一主机连续被拒几次就不再碰它；blocked 之后按下面的天数退避重试
ATTACHMENT_HOST_BLOCK_TRIP=3
ATTACHMENT_BLOCKED_RETRY_DAYS=7
# 已抽到条文的附件过多少天重取一次（官方可能在同一 URL 上换稿；哈希没变就不重解析）
ATTACHMENT_REFRESH_DAYS=30
# 单个文件下载上限，超过记 too_large（诚实降级，不去拉几十 MB 的标准全文）
ATTACHMENT_MAX_BYTES=4194304
# 单个附件最多尝试几轮（含被熔断跳过的轮次）；用满后按 blocked 退避重试
ATTACHMENT_MAX_ATTEMPTS=3
# 一轮最多处理多少条公示的附件（先到先停，剩余留到下一轮）
ATTACHMENT_NOTICES_PER_ROUND=60
# 判文件类型时只读文件头多少字节（pdf / docx / doc / html 的 magic 都在最前面）
ATTACHMENT_PROBE_BYTES=65536

# ── 摘要重试（issue #83 补上转发）────────────────────────────────
# 一次摘要最多重试几次（不含首次调用；共尝试 1 + 该值 次），用满后置 failed_review 转人工
SUMMARY_MAX_RETRIES=3
# 重试的基础退避毫秒数（实际等待按它递增）
SUMMARY_RETRY_DELAY_MS=500

# ── 每页条数（issue #83 补上转发）────────────────────────────────
# 列表页每页条数（缺省 50，留空即缺省；非法值退回缺省，不会把页面变成 0 条）
LIST_PAGE_SIZE=
# 搜索结果每页条数（缺省 50，同上）
SEARCH_PAGE_SIZE=

# ── 构建期：依赖层的 npm 源（issue #84）───────────────────────────
# 只影响 `docker compose build` 时的依赖下载，与运行时无关（不传进容器）。
# 为什么需要它：生产机在国内，实测 registry.npmjs.org 被限速到约 140 KB/s ——
# `next` 一个包的元数据 31 MB，光它就要四分钟，一次 `npm ci` 半小时跑不完，
# 表现是"构建卡死"（日志停住、load 0.04、进程 rchar 二十秒不涨）；
# registry.npmmirror.com 同一份元数据 1.65 秒。换源**不降低**供应链保证：
# `npm ci` 按 package-lock.json 的 integrity(sha512) 逐包校验，镜像站替换内容会当场失败。
# 留空 = 官方源（Dockerfile 里的 ARG 缺省值）。
NPM_REGISTRY=https://registry.npmmirror.com
