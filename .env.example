# 生产环境变量模板：`cp .env.example .env` 后填写真实值（.env 已被 gitignore，勿提交）
# 本文件与 docker-compose.yml 的 ${VAR} 引用一一对应；详尽说明见 README 环境变量表。

# ── 数据库（compose 内网）────────────────────────────────────────
POSTGRES_PASSWORD=change-me-strong-password

# ── 域名与 TLS（Caddy 自动签发 Let's Encrypt 证书）──────────────
# DOMAIN 的 DNS A 记录须已指向本机公网 IP，且安全组放行 80 / 443
DOMAIN=your-domain.example

# ── 站点对外地址（必须 https，且与 DOMAIN 一致）──────────────────
SITE_URL=https://your-domain.example
APP_BASE_URL=https://your-domain.example

# ── 大模型（PRD：已备案的国产模型；服务商可切换）─────────────────
# LLM_PROVIDER：glm（默认，智谱预设）| openai（任何 OpenAI 兼容端点）| stub（本地测试）
LLM_PROVIDER=glm
# 预设服务商（glm）——只有 Key 必填，基址与模型有默认值
GLM_API_KEY=
GLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flash
# 通用端点（LLM_PROVIDER=openai 时三项都必填；换模型只改这里，不动代码）
LLM_API_KEY=
LLM_API_BASE=
LLM_MODEL=
# 单次请求超时（毫秒，缺省 60000）与额外请求头（JSON 对象，缺省不加）
LLM_TIMEOUT_MS=
LLM_EXTRA_HEADERS=

# ── 邮件（SMTP；用于订阅确认/提醒与失败告警）────────────────────
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=true
MAIL_FROM=

# ── 检索 ────────────────────────────────────────────────────────
MEILI_MASTER_KEY=change-me-strong-master-key

# ── 管理后台与告警（ADMIN_TOKEN 建议 32 位随机串）────────────────
ADMIN_TOKEN=change-me-random-token
ALERT_EMAIL=

# ── 页脚 ICP 备案号（如 京ICP备2026000000号-1；未填则显示占位文案）──
ICP_NUMBER=

# ── 抓取调度间隔（毫秒；默认每日一轮，改小前请确认对源站足够礼貌）──
WORKER_INTERVAL_MS=86400000

# ── 限流（次/小时，按客户端 IP 的固定窗口；留空用缺省值，填 0 = 不限流）──
# 订阅端点会真的发信：不限流时任何人都能对任意邮箱反复触发确认邮件（发信域声誉）
SUBSCRIBE_RATE_LIMIT_PER_HOUR=
# 后台登录：共享密钥可被无限次在线爆破，缺省 30
ADMIN_LOGIN_RATE_LIMIT_PER_HOUR=
